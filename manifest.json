{
  "manifest_version": 3,
  "name": "SonicComp",
  "version": "1.0.0",
  "description": "Modern per-tab audio compressor with AI presets. Boost quiet videos, tame loud explosions, fix Twitch clip audio.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "offscreen"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SonicComp",
    "default_icon": {
      "16": "icons/icon-gray16.png",
      "32": "icons/icon-gray32.png",
      "48": "icons/icon-gray48.png",
      "128": "icons/icon-gray128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "116"
}
